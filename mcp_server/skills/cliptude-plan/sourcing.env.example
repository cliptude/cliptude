# Keys an agent's own tools use to find media for a render-only Cliptude plan.
# These are the user's own accounts, not Cliptude's: Cliptude never needs them and never sees them.
# Copy to your agent's environment (.env), fill in the ones you use, and never paste a key into a plan.

# Free stock photos and video (both allow commercial use without credit)
PEXELS_API_KEY=          # https://www.pexels.com/api/
PIXABAY_API_KEY=         # https://pixabay.com/api/docs/

# Public-domain archives need no key: NASA (images-api.nasa.gov), Library of Congress (loc.gov/apis),
# US National Archives (catalog.archives.gov/api), Wikimedia Commons (commons.wikimedia.org/w/api.php),
# Internet Archive (archive.org/advancedsearch.php). Check each file's own license on Commons and the Archive.

# Optional: generate your own pictures or clips with a model you have access to
OPENAI_API_KEY=          # images (gpt-image)
REPLICATE_API_TOKEN=     # many open image and video models
FAL_KEY=                 # image and video models on fal.ai
